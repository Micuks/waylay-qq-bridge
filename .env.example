# Local-only env values consumed by docker-compose.override.yml.
# Copy to `.env` and fill in your real values. `.env` is gitignored.

# Auto-login: set your QQ uin to skip QR code on restart.
# Leave empty to use the auto-pick-last-uin fallback in src/bridge.js,
# or to fall back to QR code login if no previous login exists.
AUTO_LOGIN_QQ=

# OneBot v11 reverse WebSocket targets (JSON array of URLs).
# Leave empty to disable reverse WS (forward WS on :3001 still works).
ONEBOT_WS_REVERSE_URLS=["ws://host.docker.internal:2536/OneBotv11"]

# Host path that your bot framework (e.g. Yunzai) writes file:// paths against.
# Mounted read-only into the container at the same path so file:// URIs resolve.
# Comment out the matching `volumes:` entry in docker-compose.override.yml if unused.
YUNZAI_DATA_PATH=/path/to/your/Yunzai-Bot/data
